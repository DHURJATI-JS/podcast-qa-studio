# -----------------------------------------------------------------------------
# Podcast Q&A Studio - configuration
# The one-click installer copies this file to .env and fills in random secrets.
# Never commit your real .env.
# -----------------------------------------------------------------------------
APP_ENV=production
APP_PORT=8080
BASE_URL=http://localhost:8080
# Host names the app answers to (IP addresses always work, e.g. http://192.168.0.10:8080).
ALLOWED_HOSTS=localhost
SECRET_KEY=__SECRET_KEY__
POSTGRES_PASSWORD=__DB_PASSWORD__
WEB_CONCURRENCY=2
LOG_LEVEL=INFO
LOG_JSON=false
# Set to true only behind an HTTPS reverse proxy (enables HSTS, Secure + __Host- cookies).
FORCE_HTTPS=false

# --- AI providers: tried in this order, the first available one answers --------
AI_PROVIDER_ORDER=gateway,local,anthropic,openai
# 1) Your OpenAI-compatible AI gateway on the local network (change the key on the
#    gateway AND here if you still use the default one).
GATEWAY_ENABLED=true
GATEWAY_BASE_URL=http://192.168.0.226:8000/v1
GATEWAY_API_KEY=change-me-gateway-key
GATEWAY_MODEL=gemma
# 2) Local Gemma in Docker (Ollama). EmbeddingGemma also powers pgvector similarity.
LOCAL_LLM_ENABLED=true
LOCAL_LLM_MODEL=gemma3:4b
LOCAL_EMBED_MODEL=embeddinggemma
# 3) Claude API fallback (optional - leave empty to disable)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 4) ChatGPT API fallback (optional - leave empty to disable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Embeddings for redundancy detection: local EmbeddingGemma, then OpenAI, then built-in hashing.
EMBEDDING_ORDER=local,openai,hash
# The gateway can be slow (CPU/RPC inference) - generous timeouts.
AI_READ_TIMEOUT=180
AI_JOB_TIMEOUT=900
WORKER_CONCURRENCY=8

# --- Voice: Kokoro text-to-speech -----------------------------------------------
TTS_ENABLED=true

# --- Email for password resets ------------------------------------------------------
# Leave SMTP_HOST empty on a single-user local install: reset emails are then printed
# to the server log (docker compose logs app). Never use that fallback on a shared server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Podcast Q&A Studio <no-reply@localhost>"
SMTP_STARTTLS=true
EMAIL_FALLBACK_TO_LOG=true
